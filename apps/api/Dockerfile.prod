# 프로덕션 이미지 (ECS Fargate용). api와 worker가 같은 이미지를 쓰고 command만 다르다.
#   api:    node dist/api.main
#   worker: node dist/worker.main
# dev용 Dockerfile(apps/api/Dockerfile)은 소스를 볼륨 마운트하고 watch 모드로 돌지만,
# 이 이미지는 빌드 결과(dist)를 굽는다.
#
# node-linker=isolated를 빌드 안에서만 강제하는 이유:
#   루트 .npmrc의 hoisted 링커는 --filter를 무시하고 워크스페이스 전체(Expo, React Native 포함)를
#   루트 node_modules에 깐다. isolated로 바꾸면 api와 그 의존성만 설치된다. 로컬 개발 환경은 그대로다.
#
# 런타임 스테이지는 --prod로 다시 설치한다. @bandapp/types(런타임 상수 import)와
# drizzle-kit(기동 시 마이그레이션)은 api의 dependencies에 있어야 여기 포함된다.

FROM node:22-alpine AS build

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/mobile/package.json apps/mobile/
COPY packages/types/package.json packages/types/
COPY packages/config/package.json packages/config/
COPY packages/api-client/package.json packages/api-client/

RUN pnpm install --frozen-lockfile --filter @bandapp/api... --config.node-linker=isolated

COPY packages/config packages/config
COPY packages/types packages/types
COPY apps/api apps/api

RUN pnpm --filter @bandapp/types build \
 && pnpm --filter @bandapp/api build


FROM node:22-alpine

RUN corepack enable
# worker가 청크·take를 잘라내는 데 ffmpeg/ffprobe가 필요하다. api도 같은 이미지를 쓴다.
RUN apk add --no-cache ffmpeg
WORKDIR /app
ENV NODE_ENV=production

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/mobile/package.json apps/mobile/
COPY packages/types/package.json packages/types/
COPY packages/config/package.json packages/config/
COPY packages/api-client/package.json packages/api-client/

# 설치 뒤 pnpm 스토어·메타데이터 캐시(약 45MB)는 런타임에 필요 없으니 같은 레이어에서 지운다.
RUN pnpm install --frozen-lockfile --prod --filter @bandapp/api... --config.node-linker=isolated \
 && rm -rf /root/.local/share/pnpm /root/.cache

COPY --from=build /app/packages/types/dist packages/types/dist
COPY --from=build /app/apps/api/dist apps/api/dist
# drizzle-kit migrate에 필요한 설정과 마이그레이션 SQL.
COPY apps/api/drizzle.config.ts apps/api/
COPY apps/api/drizzle apps/api/drizzle

EXPOSE 3000
WORKDIR /app/apps/api
CMD ["node", "dist/api.main"]

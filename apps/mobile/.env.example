# 실 API 서버 주소. 비워두면 AuthProvider/ApiProvider가 MockApiClient로 동작해
# 서버 없이도 앱이 fabricated mock 데이터로 로그인된 상태로 뜬다 — 실기기/실API로 검증할 땐 반드시 채울 것
# (실기기에서는 localhost가 아니라 LAN IP, 예: http://192.168.x.x:3001).
# Mock 모드에서는 업로드 진행률만 흉내 내고 재생은 시뮬레이션이다.
EXPO_PUBLIC_API_URL=

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급한다.
# 서버(apps/api)의 GOOGLE_CLIENT_IDS에도 같은 값들을 넣어야 검증이 통과한다.

# Web 클라이언트 ID — GoogleSignin.configure({ webClientId })에 쓰이고,
# 실제 idToken의 aud가 이 값으로 발급된다. iOS/Android 모두 이 값을 쓴다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS 클라이언트의 reversed client ID (com.googleusercontent.apps.<번호>-<해시>).
# app.config.ts가 이 값이 있을 때만 google-signin 플러그인을 붙인다.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# RevenueCat public SDK keys (플랫폼별). 비어 있으면 결제 화면이 "가격을 불러올 수 없음"으로 끝난다
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# 약관/개인정보/결제 문의 링크 (비어 있으면 "준비 중" 토스트)
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_BILLING_HELP_URL=

# Firebase Cloud Messaging (선택). Firebase 콘솔 > 프로젝트 설정 > 내 앱에서 받은 파일의 경로. 둘 다 있어야 플러그인이 붙는다.
# 네이티브 모듈이라 바꾼 뒤 dev client 재빌드 필요(react-native.config.js도 이 두 값으로 오토링크 여부를 정한다). 비어 있으면 Firebase가 빌드에서 빠지고 알림 설정 화면이 "이 빌드에는 푸시가 없다"고 안내한다.
# 파일을 받은 뒤 주석을 풀어라.
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
